@model CineScope.Models.Movie

@{
    ViewData["Title"] = "Edit Movie";
}

<!-- Page header for the Edit Movie page -->
<section class="form-page-header">
    <div>
        <p class="section-label">Movie Management</p>
        <h1>Edit Movie</h1>
        <p class="page-subtitle">
            Update the selected movie information in your CineScope collection.
        </p>
    </div>

    <!-- Back button to return to movies list -->
    <a asp-action="Index" class="btn back-btn">
        Back to Movies
    </a>
</section>

<!-- Main form card -->
<section class="movie-form-card">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">

        <!-- Shows model validation errors if there are any -->
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Hidden field keeps the movie Id when saving changes -->
        <input type="hidden" asp-for="Id" />

        <div class="row g-4">

            <!-- Movie title input -->
            <div class="col-md-6">
                <label asp-for="Title" class="form-label custom-label"></label>
                <input asp-for="Title" class="form-control custom-input" placeholder="Enter movie title" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <!-- Movie genre input -->
            <div class="col-md-6">
                <label asp-for="Genre" class="form-label custom-label"></label>
                <input asp-for="Genre" class="form-control custom-input" placeholder="Action, Drama, Comedy..." />
                <span asp-validation-for="Genre" class="text-danger"></span>
            </div>

            <!-- Release year input -->
            <div class="col-md-4">
                <label asp-for="ReleaseYear" class="form-label custom-label"></label>
                <input asp-for="ReleaseYear" class="form-control custom-input" placeholder="2026" />
                <span asp-validation-for="ReleaseYear" class="text-danger"></span>
            </div>

            <!-- Rating input -->
            <div class="col-md-4">
                <label asp-for="Rating" class="form-label custom-label"></label>
                <input asp-for="Rating" class="form-control custom-input" placeholder="8.5" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>

            <!-- Duration input -->
            <div class="col-md-4">
                <label asp-for="Duration" class="form-label custom-label"></label>
                <input asp-for="Duration" class="form-control custom-input" placeholder="120" />
                <span asp-validation-for="Duration" class="text-danger"></span>
            </div>

            <!-- Current poster preview and upload new poster -->
            <div class="col-md-12">

                @if (!string.IsNullOrEmpty(Model.PosterUrl))
                {
                    <label class="form-label custom-label">Current Poster</label>

                    <div class="mb-3">
                        <img src="@Model.PosterUrl"
                             alt="@Model.Title"
                             class="edit-poster-preview" />
                    </div>
                }

                <label class="form-label custom-label">Change Poster Image</label>
                <input type="file"
                       name="posterFile"
                       class="form-control custom-input"
                       accept="image/*" />

                <span asp-validation-for="PosterUrl" class="text-danger"></span>
            </div>

            <!-- Movie description input -->
            <div class="col-md-12">
                <label asp-for="Description" class="form-label custom-label"></label>
                <textarea asp-for="Description"
                          class="form-control custom-input custom-textarea"
                          rows="5"
                          placeholder="Write a short movie description..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

        </div>

        <!-- Form action buttons -->
        <div class="form-actions">
            <button type="submit" class="btn save-btn">
                Save Changes
            </button>

            <a asp-action="Index" class="btn cancel-btn">
                Cancel
            </a>
        </div>

    </form>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}